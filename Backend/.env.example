# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb://localhost:27017/himalayan_connect

# Auth / JWT
JWT_SECRET=your_super_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here

# Used for CORS (production frontend origin) and for building links in emails
FRONTEND_URL=http://localhost:3000

# Email (used to send the registration verification link).
# If left blank, verification emails are logged to the server console instead
# of actually being sent — useful for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Himalaya Connect <no-reply@himalayaconnect.app>

# Razorpay (payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Weather widget (Farmer Dashboard)
WEATHER_API_KEY=your_weather_api_key

# AI Assistant (Week 7) — real OpenAI integration for "Pahadi Mitra".
# Get a key from https://platform.openai.com/api-keys
# If left blank, the chat still works using the local rule-based engine —
# open-ended questions just won't get a real AI-generated answer.
OPENAI_API_KEY=your_openai_api_key
# Optional — defaults to gpt-4o-mini if not set
OPENAI_MODEL=gpt-4o-mini

# SMS OTP (phone verification during registration) — Fast2SMS
# Get a key from https://www.fast2sms.com/dashboard/dev-api after signing up.
# If left blank, OTPs are printed to the server console instead of being
# texted — fine for local development, required before going live.
# SMS OTP (phone verification during registration) — Fast2SMS
# Get a key from https://www.fast2sms.com/dashboard/dev-api after signing up.
# If left blank, OTPs are printed to the server console instead of being
# texted — fine for local development, required before going live.
# NOTE: this is only used as a FALLBACK if Firebase Admin (below) isn't
# configured — Firebase is the primary, real phone-OTP path.
SMS_API_KEY=your_fast2sms_api_key

# Firebase Admin (verifies real phone OTP sent via Firebase Auth on the
# frontend — see Frontend/src/firebase.js). This is the PRIMARY way phone
# numbers get verified at registration; Fast2SMS above is only a fallback.
# Get these 3 values from:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# (downloads a JSON file — copy the matching fields from it below; do NOT
# commit the JSON file itself)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# DigiLocker (instant Aadhaar verification) — requires official partner
# approval at https://partners.digilocker.gov.in or a KYC aggregator like
# Setu/Surepass. Leave blank to keep using manual Aadhaar document upload
# (fully working without this).
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# File storage (product/homestay/post photos & videos, avatars) — Cloudinary.
# Get free credentials at https://cloudinary.com/users/register/free
# REQUIRED before deploying to Render (or any host with an ephemeral
# filesystem) — without this, uploaded files disappear whenever the service
# restarts, even though the database records referencing them remain. Local
# disk storage is used automatically as a fallback if left blank, which is
# fine for local development only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OAuth — Google Sign-In ("Sign in with Google").
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to add there: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if your backend isn't on localhost:5000 (REQUIRED in production,
# e.g. Render — set to your real backend URL, or Google Sign-In's callback
# will incorrectly point at localhost).
BACKEND_URL=http://localhost:5000
