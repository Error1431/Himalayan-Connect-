# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb://localhost:27017/himalayan_connect

# Auth / JWT
JWT_SECRET=your_super_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here

# Used for CORS (production frontend origin) and for building links in emails
FRONTEND_URL=http://localhost:3000

# Email (used to send the registration verification link).
# If left blank, verification emails are logged to the server console instead
# of actually being sent — useful for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Himalaya Connect <no-reply@himalayaconnect.app>

# Razorpay (payments)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Weather widget (Farmer Dashboard)
WEATHER_API_KEY=your_weather_api_key

# AI Assistant (Week 7) — real OpenAI integration for "Pahadi Mitra".
# Get a key from https://platform.openai.com/api-keys
# If left blank, the chat still works using the local rule-based engine —
# open-ended questions just won't get a real AI-generated answer.
OPENAI_API_KEY=your_openai_api_key
# Optional — defaults to gpt-4o-mini if not set
OPENAI_MODEL=gpt-4o-mini

# OAuth — Google Sign-In ("Sign in with Google").
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to add there: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if your backend isn't on localhost:5000 (REQUIRED in production,
# e.g. Render — set to your real backend URL, or Google Sign-In's callback
# will incorrectly point at localhost).
BACKEND_URL=http://localhost:5000
